/*
 * STM32N647 DNN647 XIP image.
 *
 * The STM32N6 boot ROM loads the signed FSBL from XSPI NOR at 0x70000000.
 * The FSBL configures the NOR memory map and jumps to this application at
 * 0x70100400.  Code and read-only data execute in place; initialized and
 * zero-initialized data live in internal AXISRAM.
 */

MEMORY
{
  xspi_nor (rx) : ORIGIN = 0x70100400, LENGTH = 31743K
  ram      (rwx) : ORIGIN = 0x34000000, LENGTH = 2048K
}

OUTPUT_ARCH(arm)
ENTRY(_stext)

SECTIONS
{
  .text :
  {
    _stext = ABSOLUTE(.);
    *(.vectors)
    *(.text .text.*)
    *(.fixup)
    *(.gnu.warning)
    *(.rodata .rodata.*)
    *(.gnu.linkonce.t.*)
    *(.glue_7)
    *(.glue_7t)
    *(.got)
    *(.gcc_except_table)
    *(.gnu.linkonce.r.*)
    _etext = ABSOLUTE(.);
  } > xspi_nor

  .init_section :
  {
    _sinit = ABSOLUTE(.);
    KEEP(*(SORT_BY_INIT_PRIORITY(.init_array.*) SORT_BY_INIT_PRIORITY(.ctors.*)))
    KEEP(*(.init_array EXCLUDE_FILE(*crtbegin.o *crtbegin?.o *crtend.o *crtend?.o) .ctors))
    _einit = ABSOLUTE(.);
  } > xspi_nor

  .ARM.extab : { *(.ARM.extab*) } > xspi_nor
  __exidx_start = ABSOLUTE(.);
  .ARM.exidx : { *(.ARM.exidx*) } > xspi_nor
  __exidx_end = ABSOLUTE(.);

  _eronly = ABSOLUTE(.);

  .data :
  {
    _sdata = ABSOLUTE(.);
    *(.data .data.*)
    *(.gnu.linkonce.d.*)
    CONSTRUCTORS
    . = ALIGN(4);
    _edata = ABSOLUTE(.);
  } > ram AT > xspi_nor

  .bss :
  {
    _sbss = ABSOLUTE(.);
    *(.bss .bss.*)
    *(.gnu.linkonce.b.*)
    *(COMMON)
    . = ALIGN(4);
    _ebss = ABSOLUTE(.);
  } > ram

  .stab 0 : { *(.stab) }
  .stabstr 0 : { *(.stabstr) }
  .comment 0 : { *(.comment) }
  .debug_abbrev 0 : { *(.debug_abbrev) }
  .debug_info 0 : { *(.debug_info) }
  .debug_line 0 : { *(.debug_line) }
  .debug_pubnames 0 : { *(.debug_pubnames) }
  .debug_aranges 0 : { *(.debug_aranges) }

  /* The FSBL reads the vector table at 0x70100400.  Prevent the GNU build
   * ID note from being placed before .vectors at that address. */
  /DISCARD/ : { *(.note.gnu.build-id) }
}
