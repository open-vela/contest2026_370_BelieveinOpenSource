index 00000000000..bc30449a75d
--- /dev/null
+++ b/arch/arm/src/stm32n6/stm32_start.c
@@ -0,0 +1,304 @@
+/****************************************************************************
+ * arch/arm/src/stm32n6/stm32_start.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Licensed to the Apache Software Foundation (ASF) under one or more
